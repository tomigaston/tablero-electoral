# Autenticación Basic Auth (múltiples usuarios, mismo nivel de acceso)
# Formato: usuario:clave separados por coma. Las claves no pueden llevar comas.
# Cargar el valor real SOLO en las variables de entorno de Vercel, nunca en el repo.
AUTH_USERS=usuario1:clave1,usuario2:clave2

# Compatibilidad temporal con el esquema anterior (un solo usuario). Se puede borrar.
# AUTH_USER=
# AUTH_PASS=

# Para deshabilitar autenticación en desarrollo local
# DISABLE_AUTH=true

# Planificador: base de datos de recomendaciones y notas en Google Sheets (Apps Script).
# Cargar los valores reales SOLO en Vercel (Preview y Production), nunca en el repo. Ver docs/persistencia-google-sheets.md.
# PLANIFICADOR_SHEETS_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# PLANIFICADOR_SHEETS_TOKEN=
